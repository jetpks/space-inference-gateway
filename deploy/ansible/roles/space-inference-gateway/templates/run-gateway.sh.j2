#!/bin/bash
# InferenceServerSupervisor reaps any pre-existing listener on the configured
# engine port itself, engine-agnostic, before its first spawn — no launcher-side
# pkill needed (see ROADMAP.md).

export PORT={{ gateway_port }}
RUBYBIN="{{ ansible_facts.env.HOME }}/.local/share/mise/installs/ruby/{{ mise_ruby_version }}/bin"
export PATH="$RUBYBIN:/opt/homebrew/bin:/usr/bin:/bin"
cd "{{ gateway_src_dir }}" || exit 1
exec env -u RUBYOPT bundle exec ruby bin/space-inference-gateway
